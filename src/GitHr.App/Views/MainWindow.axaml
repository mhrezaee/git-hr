<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitHr.App.ViewModels"
        xmlns:core="using:GitHr.Core"
        xmlns:app="using:GitHr.App"
        xmlns:controls="using:GitHr.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="850"
        x:Class="GitHr.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1400" Height="850" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Title="{Binding RepositoryName, StringFormat='{}{0} — GitHr', FallbackValue='GitHr', TargetNullValue='GitHr'}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel>
    <DockPanel>
        <!-- ================= Toolbar ================= -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBackground}"
                BorderBrush="{StaticResource SubtleBorder}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="tool" Click="OpenRepository_Click" ToolTip.Tip="Open a local repository (Ctrl+O)">
                        <StackPanel Spacing="1">
                            <TextBlock Text="📂" HorizontalAlignment="Center" />
                            <TextBlock Text="Open" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" Command="{Binding CloneCommand}" ToolTip.Tip="Clone a public or private repository (Ctrl+Shift+O)">
                        <StackPanel Spacing="1">
                            <TextBlock Text="⤓" HorizontalAlignment="Center" />
                            <TextBlock Text="Clone" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Background="{StaticResource SubtleBorder}" Margin="4,4" />
                    <StackPanel VerticalAlignment="Center" Margin="6,0,16,0" IsVisible="{Binding HasRepository}">
                        <TextBlock Text="{Binding RepositoryName}" FontWeight="SemiBold" FontSize="14" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding CurrentBranch, StringFormat='⎇ {0}'}" FontSize="12" Foreground="{StaticResource Accent}" />
                            <TextBlock Text="{Binding SyncStatus}" FontSize="12" Classes="muted" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasRepository}">
                    <Button Classes="tool" Command="{Binding FetchCommand}" ToolTip.Tip="Fetch all remotes (prune deleted branches)">
                        <StackPanel Spacing="1">
                            <TextBlock Text="⇵" HorizontalAlignment="Center" />
                            <TextBlock Text="Fetch" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" Command="{Binding PullCommand}" ToolTip.Tip="Pull the current branch">
                        <StackPanel Spacing="1">
                            <TextBlock Text="↓" HorizontalAlignment="Center" />
                            <TextBlock Text="Pull" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" Command="{Binding PushCommand}" ToolTip.Tip="Push the current branch (publishes it on first push)">
                        <StackPanel Spacing="1">
                            <TextBlock Text="↑" HorizontalAlignment="Center" />
                            <TextBlock Text="Push" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" Command="{Binding RefreshCommand}" ToolTip.Tip="Reload (F5)">
                        <StackPanel Spacing="1">
                            <TextBlock Text="⟳" HorizontalAlignment="Center" />
                            <TextBlock Text="Refresh" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" Command="{Binding CloseRepositoryCommand}" ToolTip.Tip="Close repository">
                        <StackPanel Spacing="1">
                            <TextBlock Text="✕" HorizontalAlignment="Center" />
                            <TextBlock Text="Close" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsBusy}">
                    <TextBlock Text="{Binding BusyText}" Classes="muted" VerticalAlignment="Center"
                               MaxWidth="420" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding BusyText}" />
                    <ProgressBar Width="120" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                 IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding ProgressPercent, FallbackValue=0, TargetNullValue=0}" />
                    <Button Classes="small" Content="Cancel" IsVisible="{Binding CanCancel}" Command="{Binding CancelCommand}"
                            ToolTip.Tip="Stop the running git command" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Error bar ================= -->
        <Border DockPanel.Dock="Top" Background="#5A2328" Padding="12,6" IsVisible="{Binding HasError}">
            <Grid ColumnDefinitions="*,Auto">
                <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="small" Content="Dismiss" Command="{Binding DismissErrorCommand}" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- ================= Merge / rebase / cherry-pick in progress ================= -->
        <Border DockPanel.Dock="Top" Background="#4A3B1C" Padding="12,6" IsVisible="{Binding HasOperation}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Text="{Binding OperationHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="small" Content="Resolve…" Command="{Binding ResolveNextConflictCommand}" Margin="8,0,0,0"
                        IsVisible="{Binding HasConflictedFiles}" ToolTip.Tip="Open the conflict resolver for the next conflicted file" />
                <Button Grid.Column="2" Classes="small accent" Content="Continue" Command="{Binding ContinueOperationCommand}" Margin="8,0,0,0" />
                <Button Grid.Column="3" Classes="small danger" Content="Abort" Command="{Binding AbortOperationCommand}" Margin="8,0,0,0" />
            </Grid>
        </Border>

        <Panel>
            <!-- ================= Welcome screen ================= -->
            <Grid IsVisible="{Binding !HasRepository}" RowDefinitions="Auto,Auto,*" Width="560" Margin="0,80,0,40">
                <StackPanel Spacing="6">
                    <TextBlock Text="GitHr" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="A fast, free Git client for public and private repositories." Classes="muted" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Classes="accent" Content="Open repository…" Click="OpenRepository_Click" Padding="24,8" />
                        <Button Content="Clone repository…" Command="{Binding CloneCommand}" Padding="24,8" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="1" Classes="section" Text="RECENT REPOSITORIES" Margin="0,40,0,6"
                           IsVisible="{Binding RecentRepositories.Count, Converter={x:Static app:Converters.IsPositive}}" />
                <ListBox Grid.Row="2" Classes="compact" ItemsSource="{Binding RecentRepositories}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecentRepositoryViewModel">
                            <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                                <Button Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenRecentCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Path}" FontSize="12" Classes="muted" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Classes="small" Content="✕" Background="Transparent" ToolTip.Tip="Remove from list"
                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveRecentCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- ================= Repository view ================= -->
            <Grid IsVisible="{Binding HasRepository}" ColumnDefinitions="230,1,*,1,380">

                <!-- Sidebar: branches -->
                <Border Background="{StaticResource PanelBackground}">
                    <ScrollViewer>
                        <StackPanel>
                            <TextBlock Classes="section" Text="LOCAL BRANCHES" />
                            <ListBox Classes="compact" ItemsSource="{Binding LocalBranches}" DoubleTapped="Branch_DoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchItemViewModel">
                                        <Grid ColumnDefinitions="14,*,Auto" Background="Transparent"
                                              ToolTip.Tip="Double-click to check out, right-click for more">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Checkout" IsVisible="{Binding IsNotCurrent}"
                                                              Command="{Binding Owner.CheckoutCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Merge into current branch" IsVisible="{Binding IsNotCurrent}"
                                                              Command="{Binding Owner.MergeBranchCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Rebase current branch onto this…" IsVisible="{Binding IsNotCurrent}"
                                                              Command="{Binding Owner.RebaseOntoBranchCommand}" CommandParameter="{Binding}" />
                                                    <Separator IsVisible="{Binding IsNotCurrent}" />
                                                    <MenuItem Header="Create branch from here…"
                                                              Command="{Binding Owner.CreateBranchFromCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Rename…"
                                                              Command="{Binding Owner.RenameBranchCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Delete…" IsVisible="{Binding IsNotCurrent}"
                                                              Command="{Binding Owner.DeleteBranchCommand}" CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <TextBlock Text="✓" Foreground="{StaticResource Accent}" IsVisible="{Binding IsCurrent}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                       FontWeight="{Binding IsCurrent, Converter={x:Static app:Converters.BoolToWeight}}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Tracking}" FontSize="11" Classes="muted" Margin="6,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Classes="section" Text="REMOTE BRANCHES" Margin="12,16,8,4" />
                            <ListBox Classes="compact" ItemsSource="{Binding RemoteBranches}" DoubleTapped="Branch_DoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BranchItemViewModel">
                                        <Border Background="Transparent" ToolTip.Tip="Double-click to check out as a local tracking branch">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Checkout (local tracking branch)"
                                                              Command="{Binding Owner.CheckoutCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Merge into current branch"
                                                              Command="{Binding Owner.MergeBranchCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Rebase current branch onto this…"
                                                              Command="{Binding Owner.RebaseOntoBranchCommand}" CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="Create branch from here…"
                                                              Command="{Binding Owner.CreateBranchFromCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Delete from remote…"
                                                              Command="{Binding Owner.DeleteBranchCommand}" CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Tags -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,16,8,0">
                                <TextBlock Classes="section" Margin="12,0,8,4" Text="{Binding Tags.Count, StringFormat='TAGS ({0})'}" />
                                <Button Grid.Column="1" Classes="small" Content="Push all" Command="{Binding PushAllTagsCommand}"
                                        IsVisible="{Binding Tags.Count, Converter={x:Static app:Converters.IsPositive}}"
                                        ToolTip.Tip="Push all tags to the remote" />
                            </Grid>
                            <ListBox x:Name="TagList" Classes="compact" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TagItemViewModel">
                                        <Grid ColumnDefinitions="18,*,Auto" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Show in history"
                                                              Command="{Binding Owner.ShowTagInHistoryCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Checkout tag…"
                                                              Command="{Binding Owner.CheckoutTagCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Create branch from tag…"
                                                              Command="{Binding Owner.CreateBranchFromTagCommand}" CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="Push tag to remote"
                                                              Command="{Binding Owner.PushTagCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Delete tag…"
                                                              Command="{Binding Owner.DeleteTagCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Delete tag on remote…"
                                                              Command="{Binding Owner.DeleteRemoteTagCommand}" CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="Copy tag name"
                                                              Command="{Binding Owner.CopyTagNameCommand}" CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                            <TextBlock Text="◆" Foreground="#E0A83D" FontSize="10" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding ShortSha}" Classes="muted" FontSize="11"
                                                       FontFamily="{StaticResource MonoFont}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Stashes -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,16,8,0">
                                <TextBlock Classes="section" Margin="12,0,8,4" Text="{Binding Stashes.Count, StringFormat='STASHES ({0})'}" />
                                <Button Grid.Column="1" Classes="small" Content="Stash…" Command="{Binding StashWithMessageCommand}"
                                        ToolTip.Tip="Stash all changes (including untracked files) with a message" />
                            </Grid>
                            <ListBox x:Name="StashList" Classes="compact" ItemsSource="{Binding Stashes}" SelectedItem="{Binding SelectedStash}"
                                     Margin="0,0,0,12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StashItemViewModel">
                                        <StackPanel Background="Transparent" ToolTip.Tip="Click to see its files, right-click to apply, pop or drop">
                                            <StackPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Apply (keep stash)"
                                                              Command="{Binding Owner.ApplyStashCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Pop (apply and remove)"
                                                              Command="{Binding Owner.PopStashCommand}" CommandParameter="{Binding}" />
                                                    <Separator />
                                                    <MenuItem Header="Drop…"
                                                              Command="{Binding Owner.DropStashCommand}" CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </StackPanel.ContextMenu>
                                            <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                <!-- Center: graph + diff -->
                <Grid Grid.Column="2" RowDefinitions="*,1,280">
                    <ListBox Classes="commits" ItemsSource="{Binding Commits}" SelectedItem="{Binding SelectedCommit}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CommitItemViewModel">
                                <Grid ColumnDefinitions="Auto,*,140,120,70" Height="28" Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Checkout this commit…"
                                                      Command="{Binding Owner.CheckoutCommitCommand}" CommandParameter="{Binding}" />
                                            <MenuItem Header="Create branch here…"
                                                      Command="{Binding Owner.CreateBranchAtCommitCommand}" CommandParameter="{Binding}" />
                                            <MenuItem Header="Create annotated tag here…"
                                                      Command="{Binding Owner.CreateAnnotatedTagAtCommitCommand}" CommandParameter="{Binding}" />
                                            <MenuItem Header="Create tag here…"
                                                      Command="{Binding Owner.CreateTagAtCommitCommand}" CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Cherry-pick onto current branch"
                                                      Command="{Binding Owner.CherryPickCommand}" CommandParameter="{Binding}" />
                                            <MenuItem Header="Revert commit"
                                                      Command="{Binding Owner.RevertCommitCommand}" CommandParameter="{Binding}" />
                                            <MenuItem Header="Reset current branch to here">
                                                <MenuItem Header="Soft — keep changes staged"
                                                          Command="{Binding Owner.ResetSoftCommand}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Mixed — keep changes unstaged"
                                                          Command="{Binding Owner.ResetMixedCommand}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Hard — discard all changes…"
                                                          Command="{Binding Owner.ResetHardCommand}" CommandParameter="{Binding}" />
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Copy SHA"
                                                      Command="{Binding Owner.CopyShaCommand}" CommandParameter="{Binding}" />
                                            <MenuItem Header="Copy subject"
                                                      Command="{Binding Owner.CopySubjectCommand}" CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <controls:CommitGraphCell Row="{Binding Graph}" Width="{Binding GraphWidth}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ClipToBounds="True">
                                        <ItemsControl ItemsSource="{Binding Refs}" IsVisible="{Binding HasRefs}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="core:GitRef">
                                                    <Border CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                                            Background="{Binding Kind, Converter={x:Static app:Converters.RefKindBrush}}">
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="White"
                                                                   FontWeight="{Binding IsCurrent, Converter={x:Static app:Converters.BoolToWeight}}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Subject}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Author}" Classes="muted" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding Date}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding ShortSha}" Classes="muted" FontSize="12"
                                               FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <GridSplitter Grid.Row="1" ResizeDirection="Rows" />

                    <DockPanel Grid.Row="2" Background="{StaticResource PanelBackground}">
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,8,0">
                            <TextBlock Classes="section" Margin="12,6" TextTrimming="CharacterEllipsis"
                                       Text="{Binding DiffTitle, TargetNullValue='Select a file to see its diff'}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center" Text="Ctrl/Shift+click to select lines"
                                           IsVisible="{Binding CurrentDiffMode, Converter={x:Static app:Converters.IsEditableDiff}}" />
                                <Button Classes="small" Content="Stage lines" IsVisible="{Binding IsUnstagedDiff}"
                                        Command="{Binding StageLinesCommand}" ToolTip.Tip="Stage only the selected lines" />
                                <Button Classes="small danger" Content="Discard lines" IsVisible="{Binding IsUnstagedDiff}"
                                        Command="{Binding DiscardLinesCommand}" ToolTip.Tip="Discard only the selected lines" />
                                <Button Classes="small" Content="Unstage lines" IsVisible="{Binding IsStagedDiff}"
                                        Command="{Binding UnstageLinesCommand}" ToolTip.Tip="Unstage only the selected lines" />
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="DiffList" Classes="diff" ItemsSource="{Binding DiffLines}" SelectionMode="Multiple"
                                 SelectionChanged="DiffList_SelectionChanged" Background="{StaticResource AppBackground}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DiffLineViewModel">
                                    <Border Classes="diffline"
                                            Classes.added="{Binding IsAdded}"
                                            Classes.removed="{Binding IsRemoved}"
                                            Classes.hunk="{Binding IsHunk}"
                                            Classes.header="{Binding IsHeader}">
                                        <Grid ColumnDefinitions="40,40,*,Auto">
                                            <TextBlock Text="{Binding OldNumber}" Classes="lineno" />
                                            <TextBlock Grid.Column="1" Text="{Binding NewNumber}" Classes="lineno" />
                                            <TextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="4,1">
                                                <Button Classes="small" Content="Stage hunk" IsVisible="{Binding ShowStageHunk}"
                                                        Command="{Binding Owner.StageHunkCommand}" CommandParameter="{Binding}" />
                                                <Button Classes="small danger" Content="Discard hunk" IsVisible="{Binding ShowStageHunk}"
                                                        Command="{Binding Owner.DiscardHunkCommand}" CommandParameter="{Binding}" />
                                                <Button Classes="small" Content="Unstage hunk" IsVisible="{Binding ShowUnstageHunk}"
                                                        Command="{Binding Owner.UnstageHunkCommand}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>

                <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

                <!-- Right: staging / commit details -->
                <TabControl Grid.Column="4" Background="{StaticResource PanelBackground}" Padding="0"
                            SelectedIndex="{Binding SelectedTabIndex}">
                    <TabItem Header="{Binding ChangesHeader}" FontSize="14">
                        <Grid RowDefinitions="Auto,*,Auto,*,Auto">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section" Text="{Binding UnstagedFiles.Count, StringFormat='UNSTAGED ({0})'}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,8,0">
                                    <Button Classes="small danger" Content="Discard all" Command="{Binding DiscardAllCommand}"
                                            ToolTip.Tip="Discard all unstaged changes and delete untracked files" />
                                    <Button Classes="small" Content="Stage all" Command="{Binding StageAllCommand}" />
                                </StackPanel>
                            </Grid>
                            <ListBox Grid.Row="1" Classes="compact" ItemsSource="{Binding UnstagedFiles}"
                                     SelectedItem="{Binding SelectedUnstagedFile}" DoubleTapped="UnstagedFile_DoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FileChangeItemViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                                            <Border Width="18" Height="18" CornerRadius="3" Margin="0,0,8,0"
                                                    Background="{Binding Kind, Converter={x:Static app:Converters.FileKindBrush}}">
                                                <TextBlock Text="{Binding KindLetter}" FontSize="11" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" />
                                                <TextBlock Text="{Binding Directory}" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="small" Content="Stage" ToolTip.Tip="Stage this file"
                                                    Command="{Binding Owner.StageFileCommand}" CommandParameter="{Binding}" />
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Stage" Command="{Binding Owner.StageFileCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Discard changes…" Command="{Binding Owner.DiscardFileCommand}" CommandParameter="{Binding}" />
                                                    <Separator IsVisible="{Binding IsConflicted}" />
                                                    <MenuItem Header="Resolve conflicts…" IsVisible="{Binding IsConflicted}"
                                                              Command="{Binding Owner.ResolveConflictCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Take ours (whole file)" IsVisible="{Binding IsConflicted}"
                                                              Command="{Binding Owner.TakeOursCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Take theirs (whole file)" IsVisible="{Binding IsConflicted}"
                                                              Command="{Binding Owner.TakeTheirsCommand}" CommandParameter="{Binding}" />
                                                    <MenuItem Header="Mark as resolved" IsVisible="{Binding IsConflicted}"
                                                              Command="{Binding Owner.MarkResolvedCommand}" CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                <TextBlock Classes="section" Text="{Binding StagedFiles.Count, StringFormat='STAGED ({0})'}" />
                                <Button Grid.Column="1" Classes="small" Content="Unstage all" Command="{Binding UnstageAllCommand}" Margin="0,0,8,0" />
                            </Grid>
                            <ListBox Grid.Row="3" Classes="compact" ItemsSource="{Binding StagedFiles}"
                                     SelectedItem="{Binding SelectedStagedFile}" DoubleTapped="StagedFile_DoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FileChangeItemViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                                            <Border Width="18" Height="18" CornerRadius="3" Margin="0,0,8,0"
                                                    Background="{Binding Kind, Converter={x:Static app:Converters.FileKindBrush}}">
                                                <TextBlock Text="{Binding KindLetter}" FontSize="11" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" />
                                                <TextBlock Text="{Binding Directory}" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="small" Content="Unstage" ToolTip.Tip="Unstage this file"
                                                    Command="{Binding Owner.UnstageFileCommand}" CommandParameter="{Binding}" />
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Unstage" Command="{Binding Owner.UnstageFileCommand}" CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="4" Margin="12" Spacing="8">
                                <TextBox Text="{Binding CommitMessage}" PlaceholderText="Commit message (Ctrl+Enter to commit)"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalContentAlignment="Top">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding CommitCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <CheckBox Content="Amend last commit" IsChecked="{Binding IsAmend}" IsEnabled="{Binding CanAmend}"
                                          ToolTip.Tip="Replace the last commit with the staged changes and this message" />
                                <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{Binding CommitCommand}" Content="{Binding CommitButtonText}" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Commit" FontSize="14">
                        <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding SelectedCommit, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Margin="12" Spacing="4">
                                <SelectableTextBlock Text="{Binding SelectedCommitMessage}" TextWrapping="Wrap" FontSize="14" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding SelectedCommit.Author}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding SelectedCommit.Commit.AuthorEmail}" Classes="muted" FontSize="12" />
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedCommit.Date}" Classes="muted" FontSize="12" />
                                <SelectableTextBlock Text="{Binding SelectedCommit.Commit.Sha}" Classes="muted" FontSize="12"
                                                     FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Classes="section" Text="{Binding SelectedCommitFiles.Count, StringFormat='CHANGED FILES ({0})'}" />
                            <ListBox Grid.Row="2" Classes="compact" ItemsSource="{Binding SelectedCommitFiles}"
                                     SelectedItem="{Binding SelectedCommitFile}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FileChangeItemViewModel">
                                        <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding ToolTip}">
                                            <Border Width="18" Height="18" CornerRadius="3" Margin="0,0,8,0"
                                                    Background="{Binding Kind, Converter={x:Static app:Converters.FileKindBrush}}">
                                                <TextBlock Text="{Binding KindLetter}" FontSize="11" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" />
                                                <TextBlock Text="{Binding Directory}" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Stash" FontSize="14" IsVisible="{Binding HasSelectedStash}">
                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                            <StackPanel Margin="12" Spacing="4">
                                <SelectableTextBlock Text="{Binding SelectedStash.Message}" TextWrapping="Wrap" FontSize="14" />
                                <TextBlock Text="{Binding SelectedStash.Detail}" Classes="muted" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Classes="section" Text="{Binding SelectedStashFiles.Count, StringFormat='FILES ({0})'}" />
                            <ListBox Grid.Row="2" Classes="compact" ItemsSource="{Binding SelectedStashFiles}"
                                     SelectedItem="{Binding SelectedStashFile}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FileChangeItemViewModel">
                                        <Grid ColumnDefinitions="Auto,*" ToolTip.Tip="{Binding ToolTip}">
                                            <Border Width="18" Height="18" CornerRadius="3" Margin="0,0,8,0"
                                                    Background="{Binding Kind, Converter={x:Static app:Converters.FileKindBrush}}">
                                                <TextBlock Text="{Binding KindLetter}" FontSize="11" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" />
                                                <TextBlock Text="{Binding Directory}" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="12" HorizontalAlignment="Right">
                                <Button Classes="small danger" Content="Drop…" Command="{Binding DropStashCommand}" CommandParameter="{Binding SelectedStash}" />
                                <Button Classes="small" Content="Apply" Command="{Binding ApplyStashCommand}" CommandParameter="{Binding SelectedStash}"
                                        ToolTip.Tip="Apply the changes and keep the stash" />
                                <Button Classes="small accent" Content="Pop" Command="{Binding PopStashCommand}" CommandParameter="{Binding SelectedStash}"
                                        ToolTip.Tip="Apply the changes and remove the stash" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Panel>
    </DockPanel>

    <!-- ================= Command palette (Ctrl+P) ================= -->
    <Panel IsVisible="{Binding Palette.IsOpen}">
        <Border Background="#80000000" PointerPressed="PaletteBackdrop_PointerPressed" />
        <Border Width="620" MaxHeight="460" VerticalAlignment="Top" Margin="0,70,0,0"
                Background="{StaticResource ToolbarBackground}" BorderBrush="{StaticResource SubtleBorder}"
                BorderThickness="1" CornerRadius="8" BoxShadow="0 8 32 0 #A0000000">
            <DockPanel>
                <TextBox x:Name="PaletteBox" DockPanel.Dock="Top" Margin="10"
                         Text="{Binding Palette.Query}" KeyDown="PaletteBox_KeyDown"
                         PlaceholderText="Type a command, a branch to check out, or a new branch name…" />
                <TextBlock DockPanel.Dock="Bottom" Classes="muted" FontSize="11" Margin="12,6,12,8"
                           Text="↑↓ select   Enter run   Esc close" />
                <ListBox x:Name="PaletteList" Classes="compact" ItemsSource="{Binding Palette.Items}"
                         SelectedItem="{Binding Palette.SelectedItem}" Tapped="PaletteList_Tapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PaletteItem">
                            <Grid ColumnDefinitions="110,*,Auto" Margin="0,3">
                                <TextBlock Text="{Binding Category}" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Shortcut}" Classes="muted" FontSize="11"
                                           FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Panel>
    </Panel>
</Window>
