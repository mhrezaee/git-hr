<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitHr.App.App"
             xmlns:local="using:GitHr.App"
             xmlns:controls="using:GitHr.App.Controls"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <SolidColorBrush x:Key="AppBackground" Color="#1E2129" />
        <SolidColorBrush x:Key="PanelBackground" Color="#252A33" />
        <SolidColorBrush x:Key="ToolbarBackground" Color="#2B303B" />
        <SolidColorBrush x:Key="SubtleBorder" Color="#363C49" />
        <SolidColorBrush x:Key="MutedText" Color="#8B93A3" />
        <SolidColorBrush x:Key="Accent" Color="#16A9E0" />
        <SolidColorBrush x:Key="DiffAddedBackground" Color="#1F3A2B" />
        <SolidColorBrush x:Key="DiffRemovedBackground" Color="#45252A" />
        <SolidColorBrush x:Key="DiffHunkBackground" Color="#23324A" />
        <!-- The changed part of a replaced line, on top of the line's background. -->
        <SolidColorBrush x:Key="DiffAddedEmphasis" Color="#2F6B45" />
        <SolidColorBrush x:Key="DiffRemovedEmphasis" Color="#7A3038" />
        <SolidColorBrush x:Key="DiffEmptyBackground" Color="#17191F" />
        <SolidColorBrush x:Key="DiffText" Color="#D4D4D4" />
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource AppBackground}" />
        </Style>

        <!-- Section headers like "LOCAL", "STAGED" -->
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="Margin" Value="12,10,8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        </Style>

        <!-- Flat toolbar buttons with icon on top -->
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.small">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#B8444B" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="TextBlock.lineno">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- Compact list rows -->
        <Style Selector="ListBox.compact">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.compact ListBoxItem">
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- Commit graph rows must touch each other so lanes connect -->
        <Style Selector="ListBox.commits ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="28" />
        </Style>

        <!-- Diff lines -->
        <Style Selector="ListBox.diff ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Border.diffline">
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style Selector="Border.diffline.added">
            <Setter Property="Background" Value="{StaticResource DiffAddedBackground}" />
        </Style>
        <Style Selector="Border.diffline.removed">
            <Setter Property="Background" Value="{StaticResource DiffRemovedBackground}" />
        </Style>
        <Style Selector="Border.diffline.hunk">
            <Setter Property="Background" Value="{StaticResource DiffHunkBackground}" />
        </Style>
        <Style Selector="TextBlock.code">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource DiffText}" />
        </Style>
        <Style Selector="Border.diffline.added TextBlock.code">
            <Setter Property="(controls:DiffText.EmphasisBrush)" Value="{StaticResource DiffAddedEmphasis}" />
        </Style>
        <Style Selector="Border.diffline.removed TextBlock.code">
            <Setter Property="(controls:DiffText.EmphasisBrush)" Value="{StaticResource DiffRemovedEmphasis}" />
        </Style>
        <Style Selector="Border.diffline.header TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        </Style>
        <!-- Side by side: a divider between the halves; a darker cell where one side has no line. -->
        <Style Selector="Border.diffline.cell">
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <Style Selector="Border.diffline.cell.right">
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorder}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>
        <Style Selector="Border.diffline.cell.empty">
            <Setter Property="Background" Value="{StaticResource DiffEmptyBackground}" />
        </Style>
        <Style Selector="ToggleButton.small">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="{StaticResource SubtleBorder}" />
        </Style>
    </Application.Styles>
</Application>
