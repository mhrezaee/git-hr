<Project>
  <!-- Shared by every project. Release builds override the version from the git tag: -p:Version=1.2.3 (see build/publish.sh). -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Product>GitHr</Product>
    <Authors>Hadi Rezaee</Authors>
    <Copyright>Copyright (c) 2026 Hadi Rezaee</Copyright>
    <Description>A fast, free, cross-platform Git GUI.</Description>
  </PropertyGroup>
</Project>
